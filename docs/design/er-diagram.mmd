erDiagram
  zone {
    smallint zone_id PK
    varchar name UK
    varchar zone_level
    smallint parent_zone_id FK
  }
  resident {
    uuid resident_id PK
    varchar citizen_ref UK
    varchar full_name
    varchar email UK
    varchar phone
    date registered_date
    boolean is_active
  }
  property {
    uuid property_id PK
    varchar property_code UK
    uuid resident_id FK
    smallint zone_id FK
    varchar address_line
    varchar city
    char pincode
    varchar property_type
    int square_feet
    varchar service_status
  }
  utility_meter {
    uuid meter_id PK
    varchar meter_code UK
    uuid property_id FK
    utility_kind utility_type
    date installation_date
    varchar meter_model
    boolean is_active
  }
  billing_cycle {
    int cycle_id PK
    smallint year
    smallint month
    date cycle_start_date
    date cycle_end_date
    date due_date
    numeric late_penalty_percent
    varchar status
  }
  utility_rate {
    int rate_id PK
    utility_kind utility_type
    smallint tier_level
    numeric min_units
    numeric max_units
    numeric price_per_unit
    date effective_start_date
    date effective_end_date
  }
  aggregation_run {
    uuid run_id PK
    int cycle_id FK
    timestamptz started_at
    timestamptz finished_at
    varchar status
    int meters_total
    int meters_written
    text error
  }
  meter_reading {
    uuid reading_id PK
    uuid meter_id FK
    int cycle_id FK
    uuid run_id FK
    numeric opening_register
    numeric closing_register
    numeric total_units_consumed
    int source_doc_count
    boolean is_estimated
    timestamptz reading_timestamp
  }
  invoice {
    uuid invoice_id PK
    varchar invoice_no UK
    uuid property_id FK
    int cycle_id FK
    date invoice_date
    numeric total_amount
    varchar payment_status
    timestamptz paid_at
  }
  invoice_line_item {
    uuid line_item_id PK
    uuid invoice_id FK
    utility_kind utility_type
    varchar line_kind
    int rate_id FK
    smallint tier_level
    numeric units_consumed
    numeric rate_applied
    numeric line_total
  }
  payment {
    uuid payment_id PK
    uuid invoice_id FK
    varchar idempotency_key UK
    numeric amount_paid
    varchar payment_method
    varchar status
    varchar transaction_id UK
    text failure_reason
    timestamptz payment_date
  }
  maintenance_ticket {
    uuid ticket_id PK
    varchar ticket_no UK
    uuid property_id FK
    uuid meter_id FK
    varchar source
    varchar anomaly_key
    varchar issue_type
    varchar severity
    text description
    varchar status
    uuid assigned_to FK
    timestamptz reported_timestamp
    timestamptz last_seen_at
    int occurrence_count
    timestamptz resolved_at
    text resolution_notes
  }
  ticket_status_history {
    bigserial history_id PK
    uuid ticket_id FK
    varchar from_status
    varchar to_status
    uuid changed_by FK
    timestamptz changed_at
  }
  app_user {
    uuid user_id PK
    varchar email UK
    text password_hash
    varchar role
    uuid resident_id FK, UK
    smallint staff_zone_id FK
    smallint failed_logins
    timestamptz locked_until
  }
  user_session {
    bytea token_hash PK
    uuid user_id FK
    timestamptz created_at
    timestamptz expires_at
  }
  zone ||--o{ zone : "parent of"
  zone ||--o{ property : "contains"
  resident ||--o{ property : "owns"
  resident ||--o| app_user : "logs in as"
  zone |o--o{ app_user : "staff area of"
  property ||--o{ utility_meter : "has"
  utility_meter ||--o{ meter_reading : "produces"
  billing_cycle ||--o{ meter_reading : "covers"
  billing_cycle ||--o{ aggregation_run : "aggregated by"
  aggregation_run |o--o{ meter_reading : "writes"
  property ||--o{ invoice : "receives"
  billing_cycle ||--o{ invoice : "bills"
  invoice ||--|{ invoice_line_item : "contains"
  utility_rate |o--o{ invoice_line_item : "prices"
  invoice ||--o{ payment : "paid via"
  property ||--o{ maintenance_ticket : "raises"
  utility_meter |o--o{ maintenance_ticket : "flagged in"
  app_user |o--o{ maintenance_ticket : "assigned"
  maintenance_ticket ||--o{ ticket_status_history : "logs"
  app_user |o--o{ ticket_status_history : "changed by"
  app_user ||--o{ user_session : "has"
