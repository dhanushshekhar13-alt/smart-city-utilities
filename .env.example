# Copy this file to .env and change the password. .env is in .gitignore and must never be committed.

# Used by docker-compose.yml to create the PostgreSQL user and database
POSTGRES_USER=scu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smart_city

# Used by the Node.js server (keep the password in sync with POSTGRES_PASSWORD)
DATABASE_URL=postgres://scu:change-me@127.0.0.1:5432/smart_city
MONGO_URL=mongodb://127.0.0.1:27017/smart_city

# Web server
PORT=8080
SESSION_HOURS=8
# Set to true when the app is served over HTTPS
SECURE_COOKIES=false

# Simulated city clock: one tick = 15 city minutes, every TICK_MS real milliseconds
TICK_MS=2000
CLOCK_AUTOSTART=true

# Show the demo account cards on the sign-in page (set to false for a real deployment)
DEMO_MODE=true
